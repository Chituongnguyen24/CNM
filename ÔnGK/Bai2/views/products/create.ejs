<%- include("../partials/header", { title: title }) %>

<section class="card">
  <h2>Thêm sản phẩm</h2>

  <% if (errors && errors.length > 0) { %>
  <div class="alert alert-error">
    <ul>
      <% errors.forEach((err) => { %>
      <li><%= err %></li>
      <% }) %>
    </ul>
  </div>
  <% } %>

  <form class="form-grid" action="/products" method="POST" enctype="multipart/form-data">
    <label>
      Tên sản phẩm
      <input type="text" name="name" value="<%= formData.name %>" required />
    </label>

    <label>
      Giá
      <input type="number" step="0.01" min="0" name="price" value="<%= formData.price %>" required />
    </label>

    <label>
      Số lượng tồn kho
      <input type="number" min="0" name="unit_in_stock" value="<%= formData.unit_in_stock %>" required />
    </label>

    <label>
      Ảnh sản phẩm
      <input type="file" name="url_image" accept="image/*" required />
    </label>

    <div class="actions-row">
      <button class="btn btn-primary" type="submit">Lưu sản phẩm</button>
      <a class="btn btn-ghost" href="/">Hủy</a>
    </div>
  </form>
</section>

<%- include("../partials/footer") %>
