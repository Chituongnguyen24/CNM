<%- include("../partials/header", { title: title }) %>

<section class="card">
  <h2>Sửa sản phẩm</h2>

  <% if (errors && errors.length > 0) { %>
  <div class="alert alert-error">
    <ul>
      <% errors.forEach((err) => { %>
      <li><%= err %></li>
      <% }) %>
    </ul>
  </div>
  <% } %>

  <form class="form-grid" action="/products/<%= product.id %>?_method=PUT" method="POST" enctype="multipart/form-data">
    <label>
      Tên sản phẩm
      <input type="text" name="name" value="<%= product.name %>" required />
    </label>

    <label>
      Giá
      <input type="number" step="0.01" min="0" name="price" value="<%= product.price %>" required />
    </label>

    <label>
      Số lượng tồn kho
      <input type="number" min="0" name="unit_in_stock" value="<%= product.unit_in_stock %>" required />
    </label>

    <label>
      Đổi ảnh sản phẩm
      <input type="file" name="url_image" accept="image/*" />
    </label>

    <% if (product.url_image) { %>
    <div>
      <p>Ảnh hiện tại:</p>
      <img class="preview" src="<%= product.url_image %>" alt="<%= product.name %>" />
    </div>
    <% } %>

    <div class="actions-row">
      <button class="btn btn-primary" type="submit">Cập nhật</button>
      <a class="btn btn-ghost" href="/">Hủy</a>
    </div>
  </form>
</section>

<%- include("../partials/footer") %>
